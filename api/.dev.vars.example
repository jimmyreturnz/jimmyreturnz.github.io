# ADMIN_TOKEN must be 32+ characters or the inbox stays locked. Copy to .dev.vars for local dev (gitignored). The Turnstile secret below is Cloudflare's published test key that always passes.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
VISITOR_SECRET=local-dev-only-change-me
ADMIN_TOKEN=local-dev-only-change-me-32-chars-min
