---
import Page from '../layouts/Page.astro';
import Vh from '../components/Vh.astro';
import { projects } from '../data/site';
const tags = ['all', ...new Set(projects.flatMap((p) => p.tags))];
---
<Page title="Projects" description="Jimmy’s ML and data projects: shipment tracking and production OCR at BMW Group, and KatsuDon Editor, an open-source osu!taiko editor.">
  <header class="page-hero">
    <h1>Projects</h1>
    <p>Data and ML work from my internship at BMW Group, plus things I build for fun. Pinned ones first.</p>
  </header>

  <div class="filters" role="group" aria-label="Filter projects">
    {tags.map((t, i) => <button class="chip" type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-filter={t}>{t}</button>)}
  </div>
  <div class="projects">
    {projects.map((p) => (
      <article class="card proj" data-tags={p.tags.join(' ')}>
        <div class={`cover bg-${p.cover}`}>
          {p.pinned && <span class="pin">★ PINNED</span>}
          <Vh name={p.icon} />
        </div>
        <div class="body">
          <div class="tags">{p.tags.map((t) => <span class="chip">{t}</span>)}</div>
          <h2>{p.title}</h2>
          <p class="sum">{p.summary}</p>
          {p.outcome.value && <div class="outcome"><b>{p.outcome.value}</b><span>{p.outcome.text}</span></div>}
          {(p.stack || p.role) && <p class="meta">{[p.stack, p.role && `Role: ${p.role}`].filter(Boolean).join(' · ')}</p>}
          {(p.link || p.note) && (
            <p class="links">
              {p.link && <a href={p.link.href} target="_blank" rel="noopener noreferrer">{p.link.label}</a>}
              {p.note && <span class="meta">{p.note}</span>}
            </p>
          )}
        </div>
      </article>
    ))}
  </div>
</Page>

<style>
  .filters{display:flex;gap:8px;flex-wrap:wrap;margin:22px 0 20px}
  .projects{display:grid;gap:22px;grid-template-columns:repeat(auto-fill,minmax(min(100%,300px),1fr));padding-bottom:30px}
  .proj{display:flex;flex-direction:column;overflow:hidden}
  .proj[hidden]{display:none}
  .cover{position:relative;aspect-ratio:16/9;border-bottom:var(--stroke) solid var(--ink);display:grid;place-items:center}
  .cover :global(svg){width:42%;color:#fff}
  .pin{position:absolute;left:10px;top:10px;font:700 11px var(--hud);letter-spacing:.1em;background:var(--navy);color:var(--butter);border-radius:99px;padding:4px 10px}
  .body{padding:14px 16px 16px;display:flex;flex-direction:column;gap:8px;flex:1}
  .tags{display:flex;gap:6px;flex-wrap:wrap}
  .tags .chip{font-size:11px;min-height:24px;padding:var(--nudge) 9px 0;cursor:default}
  h2{font-size:19px;margin:2px 0 0}
  .sum{margin:0;font-size:14.5px}
  .outcome{display:flex;gap:10px;align-items:baseline;border:2px solid var(--ink);border-radius:12px;padding:8px 10px;background:var(--sunk)}
  .outcome b{font:700 22px/1 var(--hud);color:var(--accent);white-space:nowrap}
  .outcome span{font-size:14px}
  .links{margin:auto 0 0;display:flex;gap:14px;align-items:center;font-size:14px}
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const cards = [...document.querySelectorAll<HTMLElement>('.proj')];
    buttons.forEach((b) => b.addEventListener('click', () => {
      const f = b.dataset.filter!;
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      cards.forEach((c) => { c.hidden = f !== 'all' && !c.dataset.tags!.split(' ').includes(f); });
    }));
  });
</script>
