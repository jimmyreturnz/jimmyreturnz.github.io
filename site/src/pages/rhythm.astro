---
import Page from '../layouts/Page.astro';
import Showcase from '../components/Showcase.astro';
import ChartPlayer from '../components/ChartPlayer.astro';
import SoundCloud from '../components/SoundCloud.astro';
import { charts, profile } from '../data/site';
import { stats, fmt, rank } from '../lib/stats';
const { osu } = stats;
const mv = (v: { globalRank: number | null; countryRank: number | null; pp: number | null } | undefined, k: string) => [
  { label: `global rank (${k})`, value: rank(v?.globalRank), hint: '#00,000' },
  { label: `🇹🇭 Thailand (${k})`, value: rank(v?.countryRank), hint: '#000' },
  { label: `pp (${k})`, value: fmt(v?.pp), hint: '0,000' },
];
---
<Page title="Rhythm" description="Jimmy’s own osu!taiko and osu!mania 4K maps, playable in the browser.">
  <header class="page-hero">
    <h1>Rhythm</h1>
    <p>My own maps. Watch them play, then try them yourself. Chart carousel coming soon.</p>
  </header>

  <Showcase id="taiko" title="osu!taiko" lead="Camellia – Circles of Death." motif="vh-target" tint="mint">
    <ChartPlayer mode="taiko" {...charts.taiko} stats={[
      { label: 'global rank', value: rank(osu.taiko?.globalRank), hint: '#00,000' },
      { label: '🇹🇭 Thailand', value: rank(osu.taiko?.countryRank), hint: '#000' },
      { label: 'pp', value: fmt(osu.taiko?.pp), hint: '0,000' },
    ]} />
  </Showcase>

  <Showcase id="mania" title="osu!mania" lead="Quaoar is my 4K map; I rank in 4K and 7K. Dense, so the preview plays it for you first." motif="vh-chevrons" tint="pink">
    <ChartPlayer mode="mania" {...charts.mania} stats={[]} variants={[
      { id: '4k', label: '4K', stats: mv(osu.mania?.fourK, '4K') },
      { id: '7k', label: '7K', stats: mv(osu.mania?.sevenK, '7K') },
    ]} />
  </Showcase>

  {profile.links.soundcloud && (
    <Showcase id="soundcloud" title="On repeat" lead="Hardcore EDM I keep coming back to." motif="vh-eq" tint="lav">
      <SoundCloud url={profile.links.soundcloud} />
    </Showcase>
  )}
</Page>
