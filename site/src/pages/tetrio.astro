---
import Page from '../layouts/Page.astro';
import Vh from '../components/Vh.astro';
import Ph from '../components/Ph.astro';
import { stats, fmt, rank } from '../lib/stats';
const { tetrio } = stats;
---
<Page title="TETR.IO" description="Jimmy’s TETR.IO stats and gameplay.">
  <header class="page-hero">
    <h1>TETR.IO</h1>
    <p>Stacking since 2021.</p>
  </header>

  <div class="tetrio">
    <div class="card video" aria-label="Gameplay video (coming soon)">
      <div class="poster">
        <Vh name="vh-triangles" class="tri" />
        <p><b>Gameplay loop</b><br /><span>video coming soon · plays muted, only while on screen</span></p>
      </div>
    </div>
    <div class="card pad tstats">
      <div class="tid">
        {tetrio.avatar && <img src={tetrio.avatar} alt="TETR.IO profile picture" width="56" height="56" loading="lazy" decoding="async" />}
        <div><b>{tetrio.username}</b><small>Tetra League · {tetrio.country === 'TH' ? '🇹🇭 Thailand' : tetrio.country}</small></div>
        {tetrio.league?.rank && <span class="rankbadge" title="Tetra League rank">{tetrio.league.rank.toUpperCase()}</span>}
      </div>
      <div class="tgrid">
        <div class="stat"><b><Ph value={rank(tetrio.league?.globalRank)} hint="#000" /></b><small>global rank</small></div>
        <div class="stat"><b><Ph value={rank(tetrio.league?.countryRank)} hint="#0" /></b><small>🇹🇭 Thailand rank</small></div>
        <div class="stat"><b><Ph value={fmt(tetrio.league?.tr)} hint="00,000" /></b><small>TR</small></div>
        <div class="stat"><b><Ph value={fmt(tetrio.level)} hint="000" /></b><small>level</small></div>
        <div class="stat"><b><Ph value={tetrio.playTimeHours != null ? `${fmt(tetrio.playTimeHours)} h` : null} hint="000 h" /></b><small>playtime</small></div>
        <div class="stat"><b><Ph value={tetrio.league ? `${fmt(tetrio.league.apm, 1)} / ${fmt(tetrio.league.pps, 2)}` : null} hint="APM / PPS" /></b><small>APM / PPS</small></div>
      </div>
      <a href={tetrio.profileUrl} target="_blank" rel="noopener noreferrer">View TETR.IO profile ↗</a>
    </div>
  </div>
</Page>

<style>
  .tetrio{display:grid;grid-template-columns:1.3fr 1fr;gap:20px;margin:24px 0 30px}
  .video{overflow:hidden}
  .poster{height:100%;min-height:300px;background:var(--navy);display:grid;place-items:center;text-align:center;color:#fff8fc;padding:20px}
  .poster :global(.tri){width:140px;color:var(--sky);margin:0 auto 12px}
  .poster span{font-size:13px;opacity:.8}
  .tstats{display:flex;flex-direction:column;gap:12px}
  .tid{display:flex;align-items:center;gap:12px}
  .tid img{width:56px;height:56px;border-radius:14px;border:2px solid var(--ink);object-fit:cover}
  .tid b{display:block;font:16px var(--display)} .tid small{color:var(--muted);font-weight:700}
  .rankbadge{margin-left:auto;font:700 22px var(--hud);width:52px;height:52px;display:grid;place-items:center;border-radius:14px;
             border:var(--stroke) solid var(--ink);background:var(--lav);color:var(--on-pastel)}
  .tgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
  @media (max-width:900px){ .tetrio{grid-template-columns:1fr} }
  @media (max-width:520px){ .tgrid{grid-template-columns:1fr 1fr} }
</style>
