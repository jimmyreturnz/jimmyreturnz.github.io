---
import Page from '../layouts/Page.astro';
import Showcase from '../components/Showcase.astro';
import Vh from '../components/Vh.astro';
import { shoutouts } from '../data/site';
// The Message Board shows only when the site is built with the API address (PUBLIC_API_URL) and a Turnstile site key.
const api = import.meta.env.PUBLIC_API_URL as string | undefined, sitekey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY as string | undefined;
---
<Page title="Community" description="Shoutouts and the Message Board on jimmyreturnz’s portfolio, for friends, fellow players and visitors." jp>
  <header class="page-hero">
    <h1>Community</h1>
    <p>This page is for friends, fellow players and anyone passing by.</p>
  </header>

  <Showcase id="shoutouts" title="Shoutouts" lead="Friends and people I look up to." motif="vh-sparkle" tint="butter">
    {shoutouts.length ? (
      <div class="grid3">{shoutouts.map((s) => <div class="card pad"><b>{s.name}</b>{s.quote && <p>“{s.quote}”</p>}</div>)}</div>
    ) : (
      <div class="card pad empty"><Vh name="vh-heart-outline" /><p>No shoutouts yet.</p></div>
    )}
  </Showcase>

  {api && sitekey && (
    <Showcase id="board" title="Message Board" lead="Leave a message here" motif="vh-heart" tint="pink">
      <div class="guest" data-board data-api={api} data-sitekey={sitekey}>
        <div class="card board">
          <ol class="list" aria-live="polite" aria-label="Messages"></ol>
          <p class="state meta" role="status">Loading messages…</p>
        </div>
        <form class="card pad gform">
          <label>Name<input name="name" maxlength="40" autocomplete="nickname" required /></label>
          <label>Message <small data-count>0 / 1000</small><textarea name="message" maxlength="1000" rows="5" required></textarea></label>
          <div class="ts"></div>
          <button class="btn fill" type="submit">Send ♥</button>
          <p class="meta" role="status" data-out></p>
        </form>
      </div>
    </Showcase>
  )}
</Page>

<script>
  import { gsap } from 'gsap';
  type Msg = { id: number; name: string; body: string; link: string | null; created_at: number };
  type Turnstile = { render: (el: HTMLElement, o: object) => string; reset: (id: string) => void; remove: (id: string) => void };

  // Turnstile's script loads only once someone starts writing a message
  let tsScript: Promise<Turnstile> | null = null;
  const loadTurnstile = () => tsScript ??= new Promise((res, rej) => {
    const s = Object.assign(document.createElement('script'), { src: 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit', async: true });
    s.onload = () => res((window as unknown as { turnstile: Turnstile }).turnstile); s.onerror = rej; document.head.append(s);
  });

  document.addEventListener('astro:page-load', () => {
    const root = document.querySelector<HTMLElement>('[data-board]');
    if (!root) return;
    const api = root.dataset.api!, list = root.querySelector('ol')!, state = root.querySelector<HTMLElement>('.state')!;
    const form = root.querySelector('form')!, out = form.querySelector<HTMLElement>('[data-out]')!, count = form.querySelector<HTMLElement>('[data-count]')!;
    const date = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
    let page = 1, more = false, loading = false;

    // names and messages go in with textContent only: always plain text, never HTML
    const item = (m: Msg) => {
      const li = document.createElement('li'), head = document.createElement('div'), name = document.createElement(m.link ? 'a' : 'b');
      name.textContent = m.name; name.className = 'who';
      if (m.link) Object.assign(name, { href: m.link, rel: 'nofollow noopener ugc', target: '_blank' });
      const when = Object.assign(document.createElement('time'), { textContent: date.format(m.created_at), dateTime: new Date(m.created_at).toISOString() });
      const p = Object.assign(document.createElement('p'), { textContent: m.body });
      head.append(name, when); li.append(head, p); return li;
    };
    const load = async () => {
      if (loading) return; loading = true;
      try {
        const r = await fetch(`${api}/messages?page=${page}`); if (!r.ok) throw 0;
        const d = (await r.json()) as { items: Msg[]; more: boolean };
        const lis = d.items.map(item); list.append(...lis); more = d.more; page++;
        if (lis.length) gsap.from(lis, { y: 14, opacity: 0, duration: 0.4, stagger: 0.04, ease: 'power2.out', clearProps: 'all' });
        state.hidden = !!list.children.length; state.textContent = 'No messages yet. Be the first!';
      } catch { state.hidden = false; state.textContent = 'Messages couldn’t load right now.'; }
      loading = false;
    };
    // older pages load as the list scrolls near its end
    const board = root.querySelector<HTMLElement>('.board')!;
    board.addEventListener('scroll', () => { if (more && board.scrollTop + board.clientHeight > board.scrollHeight - 80) void load(); }, { passive: true });
    void load();

    let ts: Turnstile | null = null, wid = '', token = '';
    const ensureTs = async () => {
      if (wid) return;
      ts = await loadTurnstile().catch(() => null); if (!ts || wid) return;
      wid = ts.render(form.querySelector<HTMLElement>('.ts')!, { sitekey: root.dataset.sitekey, size: 'flexible', theme: document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light', callback: (t: string) => { token = t; }, 'expired-callback': () => { token = ''; } });
    };
    form.addEventListener('focusin', () => void ensureTs());
    const msg = form.elements.namedItem('message') as HTMLTextAreaElement;
    msg.addEventListener('input', () => { count.textContent = `${[...msg.value].length} / 1000`; });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector<HTMLButtonElement>('button')!;
      await ensureTs();
      if (!token) { out.textContent = 'One moment, the spam check is still running.'; return; }
      btn.disabled = true; out.textContent = 'Sending…';
      const fd = new FormData(form);
      try {
        const r = await fetch(`${api}/messages`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name: fd.get('name'), message: fd.get('message'), token }) });
        const d = (await r.json().catch(() => ({}))) as { error?: string };
        if (r.ok) {
          form.reset(); count.textContent = '0 / 1000';
          out.textContent = 'Thank you! Your message shows here once I’ve read it.';
          gsap.fromTo(btn, { scale: 0.9 }, { scale: 1, duration: 0.6, ease: 'elastic.out(1, 0.4)' });
        } else out.textContent = d.error ?? 'That didn’t send. Please try again.';
      } catch { out.textContent = 'That didn’t send. Please try again.'; }
      token = ''; if (ts && wid) ts.reset(wid);
      btn.disabled = false;
    });

    document.addEventListener('astro:before-swap', () => { if (ts && wid) ts.remove(wid); }, { once: true });
  });
</script>

<style>
  .guest{display:grid;grid-template-columns:1fr 1fr;gap:20px;align-items:stretch}
  /* the list is as tall as the form next to it and scrolls inside */
  .board{position:relative;min-height:240px;overflow-y:auto;overscroll-behavior:contain;padding:0;contain:size}
  .list{list-style:none;margin:0;padding:6px 18px}
  .list :global(li){padding:12px 0;border-bottom:2px dashed color-mix(in srgb,var(--ink) 18%,transparent)}
  .list :global(li:last-child){border-bottom:0}
  .list :global(li > div){display:flex;justify-content:space-between;gap:12px;align-items:baseline}
  .list :global(.who){font-weight:700;overflow-wrap:anywhere}
  .list :global(a.who){color:var(--accent)}
  .list :global(time){font-size:12px;color:var(--muted);white-space:nowrap}
  .list :global(p){margin:4px 0 0;white-space:pre-line;overflow-wrap:anywhere;font-family:var(--body),'Mali','M PLUS Rounded 1c',sans-serif}
  .state{position:absolute;inset:0;display:grid;place-items:center;margin:0;text-align:center;padding:16px}
  .state[hidden]{display:none}
  .gform{display:flex;flex-direction:column;gap:12px}
  .gform label{display:flex;flex-direction:column;gap:4px;font-weight:700;font-size:14px}
  .gform label small{font-weight:400;color:var(--muted)}
  .gform input,.gform textarea{font:inherit;font-family:var(--body),'Mali','M PLUS Rounded 1c',sans-serif;border:2px solid var(--ink);border-radius:12px;padding:8px 10px;background:var(--sunk);color:var(--ink)}
  .gform textarea{resize:vertical}
  .gform button[disabled]{opacity:.6}
  .ts:empty{display:none}
  .meta:empty{display:none}
  @media (max-width:900px){ .guest{grid-template-columns:1fr} .board{contain:none;max-height:420px} }
</style>
