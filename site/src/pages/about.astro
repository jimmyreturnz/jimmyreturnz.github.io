---
import Page from '../layouts/Page.astro';
import Showcase from '../components/Showcase.astro';
import Ph from '../components/Ph.astro';
import TetrioKeys from '../components/TetrioKeys.astro';
import { profile, skills, setups, timeline } from '../data/site';

// ruler: one tick per month, years labelled (idea: dousanmiao.com)
const Y0 = 2017, Y1 = 2028, YW = 120, MW = YW / 12;
const mi = (d: string) => { const [y, m] = d.split('-').map(Number) as [number, number]; return (y - Y0) * 12 + m - 1; };
const now = new Date(), nowI = (now.getFullYear() - Y0) * 12 + now.getMonth();
const monthYear = new Intl.DateTimeFormat('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const fmt = (d: string) => monthYear.format(new Date(`${d}-01T00:00:00Z`));
const dur = (m: number) => ((m >= 12 ? `${Math.floor(m / 12)} yr` : '') + (m % 12 ? ` ${m % 12} mo` : '')).trim();
const stages = timeline.map((t) => {
  const a = mi(t.from), months = (t.to ? mi(t.to) : nowI) - a + 1;
  return { ...t, x: a * MW, w: months * MW, range: `${fmt(t.from)} – ${t.to ? fmt(t.to) : 'Present'}${t.expected ? ' (expected)' : ''}`, dur: dur(months) };
});
---
<Page title="About" description="About Jimmy (Apiwat Kongsawat, jimmyreturnz), data scientist intern at BMW Group and Mahidol University student. Skills, setups and timeline.">
  <header class="page-hero">
    <h1>About</h1>
    <p class="intro">I’m Apiwat Kongsawat (Jimmy), also known as jimmyreturnz.<br />I study Industrial Mathematics &amp; Data Science at Mahidol University and enjoy putting data to work, whether on a production line, in a logistics team, at a nationwide competition, or in my own projects.</p>
    <ul class="facts" aria-label="Quick facts">
      <li class="chip">📍 {profile.location}</li>
      <li class="chip">🎓 {profile.study}</li>
      <li class="chip" lang="en">💬 {profile.languages}</li>
    </ul>
  </header>

  <Showcase id="timeline" title="Timeline" motif="vh-arrow-thin" tint="sky">
    <div class="card pad ruler" data-ruler style={`--yw:${YW}px`}>
      <div class="vp">
        <div class="track" style={`width:calc(var(--pad) * 2 + ${(Y1 - Y0) * YW}px)`}>
          {Array.from({ length: Y1 - Y0 + 1 }, (_, i) => <span class="yr" style={`left:calc(var(--pad) + ${i * YW}px)`}>{Y0 + i}</span>)}
          <span class="now" style={`left:calc(var(--pad) + ${nowI * MW}px)`} aria-hidden="true"></span>
          {stages.map((t, i) => (
            <button type="button" class:list={['stage', { hl: t.highlight }]} data-i={i} aria-pressed="false" style={`left:calc(var(--pad) + ${t.x}px);width:${t.w}px;top:${58 + t.lane * 40}px`}>{t.highlight ? '★ ' : ''}{t.short}</button>
          ))}
        </div>
      </div>
      {stages.map((t, i) => (
        <div class="row" data-row={i} hidden>
          <div><span class="meta">{t.where}</span><b>{t.what}</b><span class="meta">{t.range}</span>{t.blurb && <span class="blurb">{t.blurb}</span>}</div>
          <span class="when">{t.dur}</span>
        </div>
      ))}
    </div>
  </Showcase>

  <Showcase id="skills" title="Skills" lead="What I’ve used in real work, and what I’m still learning." motif="vh-dots" tint="mint">
    <dl class="card skills">
      {skills.map((g) => (
        <div class="srow">
          <dt>{g.group}</dt>
          <dd translate="no">{g.items.map((s) => <span>{s}</span>)}</dd>
        </div>
      ))}
    </dl>
  </Showcase>

  <Showcase id="setups" title="Setups" lead="My gear and game settings." motif="vh-eq" tint="lav">
    <div class="grid3">
      {setups.map((g) => (
        <div class="card pad"><h3>{g.group}</h3>
          <dl>{g.items.map((i) => <><dt>{i.label}</dt><dd><Ph value={i.value} hint="…" /></dd></>)}</dl>
        </div>
      ))}
    </div>
    <TetrioKeys />
  </Showcase>
</Page>

<style>
  .page-hero .intro{color:var(--ink);font-weight:400;font-size:17px;max-width:60ch}
  .facts{list-style:none;margin:14px 0 0;padding:0;display:flex;flex-wrap:wrap;gap:8px}
  .facts .chip{cursor:default}
  @media (max-width:520px){ .facts .chip{white-space:normal;text-align:left;line-height:1.3;padding-block:6px 4px} }
  /* skills: one card, a row per group, plain words separated by dots */
  .skills{margin:0;padding:6px 22px}
  .srow{display:grid;grid-template-columns:200px minmax(0,1fr);gap:6px 24px;padding:14px 0;border-top:2px dashed var(--dash)}
  .srow:first-child{border-top:0}
  .srow dt{font:15px/1.4 var(--display)}
  .srow dd{margin:0;min-width:0;overflow-wrap:break-word;font-size:15px;line-height:1.7}
  .srow dd > *:not(:last-child)::after{content:'·';margin:0 .55em;color:var(--dash);font-weight:700}
  .srow:last-child dd{color:var(--muted)} /* Learning row reads quieter */
  @media (max-width:640px){ .skills{padding:4px 16px} .srow{grid-template-columns:minmax(0,1fr)} }
  .grid3 dl{margin:0;display:grid;grid-template-columns:auto 1fr;gap:6px 14px;font-size:14px}
  .grid3 dt{color:var(--muted);font-weight:700} .grid3 dd{margin:0}
  /* ruler timeline: one tick per month, a bar per stage; scroll or drag sideways, click a bar for details */
  .ruler{--pad:160px;--rule:color-mix(in srgb,var(--ink) 30%,transparent);max-width:760px}
  .vp{position:relative;overflow-x:auto;scrollbar-width:none;cursor:grab;-webkit-mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent);mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent)}
  .vp::-webkit-scrollbar{display:none}
  .vp.drag{cursor:grabbing;user-select:none}
  .track{position:relative;height:178px;box-sizing:content-box;padding:0 var(--pad);background:
    linear-gradient(90deg,var(--rule) 1px,transparent 1px) 0 24px/calc(var(--yw) / 12) 8px repeat-x,
    linear-gradient(90deg,var(--rule) 1px,transparent 1px) 0 24px/calc(var(--yw) / 4) 14px repeat-x,
    linear-gradient(90deg,var(--ink) 2px,transparent 2px) 0 24px/var(--yw) 22px repeat-x;background-origin:content-box}
  .yr{position:absolute;top:0;transform:translateX(-50%);font:700 12px var(--hud);color:var(--muted)}
  .now{position:absolute;top:24px;bottom:0;width:0;border-left:2px dashed var(--accent);opacity:.7}
  .stage{position:absolute;height:32px;box-sizing:border-box;padding:0 10px;display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;text-align:left;
    background:color-mix(in srgb,var(--accent) 14%,var(--paper));border:2px solid var(--ink);border-radius:99px;color:var(--ink);font:700 12px var(--hud);cursor:pointer;transition:background .25s,color .25s,transform .25s}
  .stage.hl{background:var(--butter);color:var(--on-pastel)}
  @media (hover:hover) and (pointer:fine){ .stage:hover{transform:translateY(-2px)} }
  .stage:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
  .stage[aria-pressed="true"]{background:var(--accent);color:#fff;border-color:var(--accent)}
  .row{display:flex;justify-content:space-between;align-items:flex-end;gap:12px;margin-top:12px}
  .row[hidden]{display:none}
  .row div{display:grid;gap:2px}
  .row b{font-size:clamp(18px,3vw,22px)}
  .blurb{font-size:14px;margin-top:4px}
  .when{font:700 clamp(24px,5vw,34px)/1 var(--hud);color:var(--accent);text-align:right;white-space:nowrap;font-variant-numeric:tabular-nums}
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const box = document.querySelector<HTMLElement>('[data-ruler]');
    if (!box || box.dataset.on) return;
    box.dataset.on = '1';
    const vp = box.querySelector<HTMLElement>('.vp')!;
    const stages = [...box.querySelectorAll<HTMLButtonElement>('.stage')], rows = [...box.querySelectorAll<HTMLElement>('.row')];
    const pick = (i: number, smooth = true) => {
      stages.forEach((b, j) => { b.setAttribute('aria-pressed', String(i === j)); rows[j]!.hidden = i !== j; });
      const b = stages[i]!; vp.scrollTo({ left: b.offsetLeft + b.offsetWidth / 2 - vp.clientWidth / 2, behavior: smooth ? 'smooth' : 'auto' });
    };
    stages.forEach((b, i) => b.addEventListener('click', () => { if (!vp.classList.contains('moved')) pick(i); }));
    // mouse drag scrolls too (touch and trackpad scroll natively); a drag is not a click
    let x0 = 0, s0 = 0, down = false;
    vp.addEventListener('pointerdown', (e) => { if (e.pointerType !== 'mouse') return; down = true; x0 = e.clientX; s0 = vp.scrollLeft; vp.classList.remove('moved'); });
    addEventListener('pointermove', (e) => { if (!down) return; const dx = e.clientX - x0; if (Math.abs(dx) > 4) { vp.classList.add('drag', 'moved'); vp.scrollLeft = s0 - dx; } });
    addEventListener('pointerup', () => { if (!down) return; down = false; vp.classList.remove('drag'); setTimeout(() => vp.classList.remove('moved')); });
    pick(stages.length - 1, false);
  });
</script>
