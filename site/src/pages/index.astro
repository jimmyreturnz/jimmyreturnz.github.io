---
// Lobby: a cosy landing page. (The Intro animation will end on this page later.)
import Base from '../layouts/Base.astro';
import Settings from '../components/Settings.astro';
import PlayerCard from '../components/PlayerCard.astro';
import Socials from '../components/Socials.astro';
import Vh from '../components/Vh.astro';
import Intro from '../components/Intro.astro';
import Histogram from '../components/Histogram.astro';
import Orbit from '../components/Orbit.astro';
import { profile } from '../data/site';
import rawStats from '../data/stats.json';
import type { Stats } from '../../scripts/fetch-stats';
const stats = rawStats as unknown as Stats;
const avatar = stats.osu.avatar;
---
<Base title="Apiwat Kongsawat (jimmyreturnz) · Data Scientist & Developer">
  <Intro />
  <div class="lobby">
    <div class="sky" aria-hidden="true">
      <span class="blob b1"></span><span class="blob b2"></span><span class="blob b3"></span>
      <Vh name="vh-rings" class="r1" />
      <Vh name="vh-rings" class="r2" />
      <Vh name="vh-heart" class="h1" /><Vh name="vh-heart-outline" class="h2" /><Vh name="vh-sparkle" class="s1" /><Vh name="vh-sparkle" class="s2" />
    </div>

    <Histogram />

    <div class="bar">
      <a class="wordmark" href="/"><Vh name="vh-heart" />jimmyreturnz</a>
      <Settings />
    </div>

    <main class="hero">
      <section class="who" aria-labelledby="hi">
        <p class="bubble">Welcome! Make yourself at home <span aria-hidden="true">♥</span></p>

        <div class="id">
          <div class="avatar">
            {avatar ? <img src={avatar} alt="Jimmy’s avatar" width="128" height="128" /> : <Vh name="vh-heart" />}
            <Vh name="vh-heart" class="pin" />
            <Orbit />
          </div>
          <div>
            <p class="hello" id="hi">Hello, I am</p>
            <h1>{profile.handle}</h1>
            <p class="names">{profile.fullName} ({profile.nickname})</p>
          </div>
        </div>

        <div class="role"><b>{profile.role}</b><span>{profile.aspiration}</span></div>
        <div class="about">{profile.bio.map((p) => <p>{p}</p>)}</div>

        <ul class="facts" aria-label="Quick facts">
          {profile.openTo && <li class="chip open">💼 Open to {profile.openTo}</li>}
          {profile.location && <li class="chip">📍 {profile.location}</li>}
          <li class="chip">🎓 {profile.study}</li>
        </ul>

        <div class="ctas">
          <a class="enter-btn" href="/projects/" data-warp><Vh name="vh-heart-target" />ENTER</a>
          <a class="btn" href={`mailto:${profile.email}`}>Say hi</a>
        </div>
        <Socials />
      </section>

      <PlayerCard />
    </main>
  </div>
</Base>

<style>
  .lobby{position:relative;min-height:100vh;min-height:100dvh;overflow:hidden;padding-bottom:8px}
  /* soft room-like background */
  .sky{position:absolute;inset:0;pointer-events:none;z-index:0;
       background-image:radial-gradient(color-mix(in srgb,var(--ink) 9%,transparent) 1.2px,transparent 1.4px);background-size:22px 22px}
  .sky :global(svg){position:absolute}
  .blob{position:absolute;border-radius:50%;filter:blur(40px);opacity:.55}
  .b1{width:520px;height:520px;background:var(--pink);left:-160px;top:-180px}
  .b2{width:460px;height:460px;background:var(--lav);right:-140px;top:120px}
  .b3{width:420px;height:420px;background:var(--mint);left:30%;bottom:-260px;opacity:.4}
  :global(:root[data-theme="dark"]) .blob{opacity:.18}
  .sky :global(.r1){right:-150px;top:-170px;width:440px;color:var(--lav);opacity:.55}
  .sky :global(.r2){left:-130px;bottom:120px;width:300px;color:var(--sky);opacity:.45}
  .sky :global(.h1){left:47%;top:12%;width:30px;color:var(--pink)}
  .sky :global(.h2){right:6%;top:56%;width:38px;color:var(--pink);opacity:.8}
  .sky :global(.s1){left:6%;top:44%;width:20px;color:var(--butter)}
  .sky :global(.s2){right:40%;top:6%;width:16px;color:var(--sky)}

  /* idle loops: a slow colour drift (cheap, transform only) and pulsing rings. No arrows in the Lobby for now. */
  .sky::before{content:'';position:absolute;inset:-25%;background:conic-gradient(from 0deg at 50% 50%,var(--pink),var(--lav),var(--sky),var(--mint),var(--pink));opacity:.16;filter:blur(60px);animation:lobby-drift 40s linear infinite}
  @keyframes lobby-drift{to{transform:rotate(360deg)}}
  .sky :global(.r1){animation:ring-pulse 6s ease-in-out infinite}
  .sky :global(.r2){animation:ring-pulse 7.5s ease-in-out -3s infinite}
  @keyframes ring-pulse{0%,100%{transform:scale(1);opacity:.45}50%{transform:scale(1.08);opacity:.7}}
  :global(:root[data-theme="dark"]) .sky::before{opacity:.08}

  .hero{position:relative;z-index:2;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,500px);gap:clamp(24px,4vw,56px);align-items:center;
        max-width:1180px;margin:0 auto;padding:12px clamp(16px,4vw,40px) 28px}
  .hero > :global(*){min-width:0}
  .who{display:flex;flex-direction:column;gap:14px}
  .bubble{align-self:flex-start;margin:0;position:relative;background:var(--paper);border:2px solid var(--ink);border-radius:18px 18px 18px 4px;
          padding:8px 14px;font-weight:700;font-size:14px;box-shadow:3px 3px 0 var(--pink)}
  .bubble span{color:var(--accent)}
  .id{display:flex;align-items:center;gap:20px}
  .avatar{position:relative;flex:none;width:clamp(96px,12vw,128px);aspect-ratio:1;border-radius:32px;border:var(--stroke) solid var(--ink);
          box-shadow:5px 5px 0 var(--pink);background:var(--pink);overflow:visible;display:grid;place-items:center}
  .avatar img{width:100%;height:100%;object-fit:cover;border-radius:29px;display:block}
  .avatar > :global(svg:not(.pin)){width:56%;color:#fff}
  .avatar :global(.pin){position:absolute;right:-12px;bottom:-10px;width:34px;color:var(--pink);transform:rotate(12deg)}
  .hello{margin:0;font-weight:700;color:var(--muted);font-size:15px}
  h1{font-size:clamp(22px,3.5vw,42px);margin:0;line-height:1;white-space:nowrap}
  .names{margin:4px 0 0;color:var(--muted);font-weight:700;font-size:14px}
  .role{display:flex;flex-wrap:wrap;align-items:center;gap:6px 12px}
  .role b{font:clamp(16px,2.2vw,22px)/1.2 var(--display);background:var(--mint);color:var(--on-pastel);border:var(--stroke) solid var(--ink);
          border-radius:12px;padding:6px 14px;box-shadow:3px 3px 0 var(--shadow-c)}
  .role span{font-size:14px;color:var(--muted);font-weight:700}
  .about{max-width:52ch;font-size:16.5px}
  .about p{margin:0 0 6px}
  .facts{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:8px}
  .facts .chip{cursor:default}
  .facts .open{background:var(--butter);color:var(--on-pastel)}
  .ctas{display:flex;flex-wrap:wrap;align-items:center;gap:14px;margin-top:4px}

  /* the Lobby's one main action */
  .enter-btn{display:inline-flex;align-items:center;gap:12px;border:4px solid var(--navy);border-radius:99px;background:var(--navy);color:var(--butter);
     font:clamp(20px,2.4vw,26px)/1 var(--display);letter-spacing:.08em;padding:10px 28px 10px 14px;text-decoration:none;box-shadow:5px 5px 0 var(--pink);
     transition:box-shadow .16s cubic-bezier(.23,1,.32,1)}
  .enter-btn :global(svg){width:38px;color:var(--pink);--vh-ink:#1f1e33}
  @media (hover:hover) and (pointer:fine){ .enter-btn:hover{box-shadow:8px 8px 0 var(--pink)} }
  :global(:root[data-theme="dark"]) .enter-btn{border-color:var(--pink)}

  @media (max-width:900px){
    .hero{grid-template-columns:1fr;padding-top:0}
  }
  @media (max-width:520px){
    .id{flex-direction:column;align-items:flex-start;gap:14px}
    .sky :global(.h1){display:none}
    h1{font-size:clamp(22px,8.4vw,38px)}
    .facts .chip{white-space:normal;text-align:left;line-height:1.3;padding-block:6px 4px}
  }
</style>
