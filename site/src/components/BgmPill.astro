---
// The BGM pill in the top bar (Lobby and Portfolio): scrolling title + Pause. scripts/bgm.ts fills the title and wires the button.
import Vh from './Vh.astro';
import { bgm } from '../data/site';
---
<div class="bgm" role="group" aria-label="Background music" title={`Arr. ${bgm.arranger}`}>
  <Vh name="vh-eq" class="eq" />
  <span class="t" data-bgm-title>BGM</span>
  <button type="button" class="pause" aria-pressed="false" data-bgm-toggle>Pause</button>
</div>

<style>
  .bgm{display:flex;align-items:center;gap:10px;height:var(--ctl);border:2px solid var(--ink);border-radius:99px;padding:0 4px 0 12px;background:var(--paper);font-size:13px;font-weight:700;min-width:0}
  .bgm :global(.eq){width:24px;color:var(--lav)}
  .pause{height:26px;border:2px solid var(--ink);border-radius:99px;background:var(--butter);color:var(--on-pastel);padding:0 12px;font-size:12px;font-weight:700;line-height:1}
  .t{white-space:nowrap;overflow:hidden;max-width:min(26ch,24vw);mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent)}
  /* the title scrolls sideways: the text is there twice, so sliding by half its width loops without a jump */
  .t :global(.mq){display:inline-flex;gap:3ch;animation:bgmscroll 14s linear infinite;will-change:transform}
  .t:hover :global(.mq){animation-play-state:paused}
  @keyframes bgmscroll{to{transform:translateX(calc(-50% - 1.5ch))}}
  @media (max-width:820px){ .t{display:none} .bgm{padding-left:8px} }
  @media (max-width:440px){ .bgm{display:none} }
</style>
