---
import SoundToggle from './SoundToggle.astro';
import ThemeSwitch from './ThemeSwitch.astro';
---
<div class="settings" role="group" aria-label="Site settings">
  <div class="snd">
    <div class="vols">
      <label title="Music volume"><span aria-hidden="true">♪</span><span class="sr-only">Music volume</span><input type="range" min="0" max="100" step="1" data-vol="music" /></label>
      <label title="Effects volume"><span aria-hidden="true">fx</span><span class="sr-only">Effects volume</span><input type="range" min="0" max="100" step="1" data-vol="sfx" /></label>
    </div>
    <SoundToggle />
  </div>
  <ThemeSwitch />
</div>

<style>
  /* the speaker button grows a volume bar to its left on hover or keyboard focus (and after a tap on touch) */
  .snd{display:flex;align-items:center}
  .vols{display:flex;align-items:center;gap:10px;height:var(--ctl);max-width:0;opacity:0;overflow:hidden;margin-right:0;padding:0;
        border:2px solid transparent;border-radius:99px;background:var(--paper);white-space:nowrap;
        transition:max-width .3s ease,opacity .2s ease,margin .3s ease,padding .3s ease,border-color .3s}
  .snd:hover .vols,.snd:focus-within .vols{max-width:230px;opacity:1;margin-right:8px;padding:0 12px;border-color:var(--ink)}
  .vols label{display:flex;align-items:center;gap:6px;font:700 11px var(--hud);color:var(--muted)}
  .vols input{width:72px;accent-color:var(--accent);cursor:pointer}
  @media (max-width:520px){ .vols input{width:56px} }
</style>

<script>
  import { vol, setVolume } from '../scripts/audio';
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLInputElement>('[data-vol]').forEach((r) => {
      const k = r.dataset.vol as 'sfx' | 'music';
      r.value = String(Math.round(vol[k] * 100));
      r.oninput = () => setVolume(k, Number(r.value) / 100);
    });
  });
</script>
