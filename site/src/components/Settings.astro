---
import SoundToggle from './SoundToggle.astro';
import ThemeSwitch from './ThemeSwitch.astro';
---
<div class="settings" role="group" aria-label="Site settings">
  <div class="snd">
    <div class="vols">
     <div class="in">
      <label title="Music volume"><span aria-hidden="true">♪</span><span class="sr-only">Music volume</span><input type="range" min="0" max="100" step="1" data-vol="music" /></label>
      <label title="Effects volume"><span aria-hidden="true">fx</span><span class="sr-only">Effects volume</span><input type="range" min="0" max="100" step="1" data-vol="sfx" /></label>
     </div>
    </div>
    <SoundToggle />
  </div>
  <ThemeSwitch />
</div>

<style>
  /* the speaker button grows a volume bar to its left on hover or keyboard focus (and after a tap on touch).
     The width is animated as a grid track (0fr -> 1fr), so it opens to the exact size with an ease-out curve; the sliders fade and slide in one
     after the other, and closing waits a moment so a pointer crossing the small gap doesn't make it flicker. */
  .snd{display:flex;align-items:center;--ease:cubic-bezier(.22,1,.36,1)}
  .vols{display:grid;grid-template-columns:0fr;align-items:center;height:var(--ctl);opacity:0;margin-right:0;padding:0;
        border:2px solid transparent;border-radius:99px;background:var(--paper);white-space:nowrap;transform:translateX(12px) scale(.96);transform-origin:right center;
        transition:grid-template-columns .5s var(--ease) .12s,opacity .25s ease .12s,margin .5s var(--ease) .12s,padding .5s var(--ease) .12s,transform .5s var(--ease) .12s,border-color .3s ease .12s}
  .snd:hover .vols,.snd:focus-within .vols{grid-template-columns:1fr;opacity:1;margin-right:8px;padding:0 12px;border-color:var(--ink);transform:none;transition-delay:0s}
  .vols .in{display:flex;align-items:center;gap:10px;overflow:hidden;min-width:0}
  .vols label{display:flex;align-items:center;gap:6px;font:700 11px var(--hud);color:var(--muted);opacity:0;transform:translateX(10px);transition:opacity .2s ease,transform .45s var(--ease)}
  .snd:hover .vols label,.snd:focus-within .vols label{opacity:1;transform:none}
  .snd:hover .vols label:nth-child(1),.snd:focus-within .vols label:nth-child(1){transition-delay:.08s}
  .snd:hover .vols label:nth-child(2),.snd:focus-within .vols label:nth-child(2){transition-delay:.16s}
  .vols input{width:72px;accent-color:var(--accent);cursor:pointer}
  @media (max-width:520px){ .vols input{width:56px} }
</style>

<script>
  import { vol, setVolume } from '../scripts/audio';
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLInputElement>('[data-vol]').forEach((r) => {
      const k = r.dataset.vol as 'sfx' | 'music';
      r.value = String(Math.round(vol[k] * 100));
      r.oninput = () => setVolume(k, Number(r.value) / 100);
    });
  });
</script>
