---
// The soft room-like background: dot grid, pastel blobs, a slow colour drift, pulsing rings, a few hearts and sparkles.
// Lobby: fills the Lobby box (the Intro animates its hearts). Portfolio pages: `fixed`, so it stays behind the content while scrolling.
import Vh from './Vh.astro';
interface Props { fixed?: boolean }
const { fixed = false } = Astro.props;
// snow: small flakes drifting down; negative delays so the sky is already full on load
const r = (a: number, b: number) => a + Math.random() * (b - a);
const flakes = Array.from({ length: 36 }, () =>
  `left:${r(0, 100).toFixed(1)}%;--s:${r(2, 5).toFixed(1)}px;--dx:${r(-40, 40).toFixed(0)}px;--o:${r(0.5, 0.95).toFixed(2)};animation-duration:${r(16, 32).toFixed(1)}s;animation-delay:-${r(0, 32).toFixed(1)}s`);
---
<div class:list={['sky', { fixed }]} aria-hidden="true">
  <span class="blob b1"></span><span class="blob b2"></span><span class="blob b3"></span>
  {flakes.map((style) => <i class="flake" style={style}></i>)}
  <Vh name="vh-rings" class="r1" />
  <Vh name="vh-rings" class="r2" />
  <Vh name="vh-heart" class="h1" /><Vh name="vh-heart-outline" class="h2" /><Vh name="vh-sparkle" class="s1" /><Vh name="vh-sparkle" class="s2" />
</div>

<style>
  .sky{position:absolute;inset:0;pointer-events:none;z-index:0;overflow:hidden;
       background-image:radial-gradient(color-mix(in srgb,var(--ink) 9%,transparent) 1.2px,transparent 1.4px);background-size:22px 22px}
  .sky.fixed{position:fixed}
  .sky :global(svg){position:absolute}
  .blob{position:absolute;border-radius:50%;filter:blur(40px);opacity:.55}
  .b1{width:520px;height:520px;background:var(--pink);left:-160px;top:-180px}
  .b2{width:460px;height:460px;background:var(--lav);right:-140px;top:120px}
  .b3{width:420px;height:420px;background:var(--mint);left:30%;bottom:-260px;opacity:.4}
  :global(:root[data-theme="dark"]) .blob{opacity:.18}
  .sky :global(.r1){right:-150px;top:-170px;width:440px;color:var(--lav);opacity:.55}
  .sky :global(.r2){left:-130px;bottom:120px;width:300px;color:var(--sky);opacity:.45}
  .sky :global(.h1){left:47%;top:12%;width:30px;color:var(--pink)}
  .sky :global(.h2){right:6%;top:56%;width:38px;color:var(--pink);opacity:.8}
  .sky :global(.s1){left:6%;top:44%;width:20px;color:var(--butter)}
  .sky :global(.s2){right:40%;top:6%;width:16px;color:var(--sky)}
  /* Portfolio pages: the hearts sit in the margins, away from the text */
  .fixed :global(.h1){left:auto;right:3%;top:22%}
  .fixed :global(.s2){right:auto;left:3%;top:78%}

  /* idle loops: a slow colour drift (cheap, transform only) and pulsing rings */
  .sky::before{content:'';position:absolute;inset:-25%;background:conic-gradient(from 0deg at 50% 50%,var(--pink),var(--lav),var(--sky),var(--mint),var(--pink));opacity:.16;filter:blur(60px);animation:lobby-drift 40s linear infinite}
  @keyframes lobby-drift{to{transform:rotate(360deg)}}
  .sky :global(.r1){animation:ring-pulse 6s ease-in-out infinite}
  .sky :global(.r2){animation:ring-pulse 7.5s ease-in-out -3s infinite}
  @keyframes ring-pulse{0%,100%{transform:scale(1);opacity:.45}50%{transform:scale(1.08);opacity:.7}}
  :global(:root[data-theme="dark"]) .sky::before{opacity:.08}
  /* snow: transform-only fall + sway; container units so it spans the Lobby box or the viewport */
  .sky{container-type:size}
  .flake{position:absolute;top:-12px;width:var(--s);height:var(--s);border-radius:50%;background:#fff;opacity:var(--o);
         box-shadow:0 0 6px 1px color-mix(in srgb,var(--lav) 80%,transparent);animation:snow linear infinite;will-change:transform}
  @keyframes snow{
    0%{transform:translate3d(0,0,0)}
    50%{transform:translate3d(var(--dx),calc(50cqh + 12px),0)}
    100%{transform:translate3d(0,calc(100cqh + 24px),0)}
  }
  @media (max-width:520px){ .sky :global(.h1){display:none} .flake:nth-of-type(n+20){display:none} }
  @media (prefers-reduced-motion:reduce){ :global(:root:not([data-motion="full"])) .flake{display:none} }
</style>
