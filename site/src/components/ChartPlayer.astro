---
// Chart Showcase. One or more charts (osu!mania 4K / 7K share one card with a key-mode switch).
// Song preview + seek slider switch on by themselves once the song file is in assets/audio/.
// Note rendering from the .osu file (synced to the slider) and Play mode arrive with the animation pass.
import Vh from './Vh.astro';
import Ph from './Ph.astro';
import KeySwitch from './KeySwitch.astro';
import { camelliaUrl, maniaScrollTimeMs, type Chart } from '../data/site';
import { audioSources } from '../lib/assets';

interface Stat { label: string; value: string | null; hint: string }
interface Item { chart: Chart; label?: string; stats: Stat[] }
interface Props { items: Item[] }
const { items } = Astro.props;
const multi = items.length > 1;
const mmss = (s: number) => `${Math.floor(s / 60)}:${String(Math.round(s % 60)).padStart(2, '0')}`;
const lanesOf = (c: Chart) => (c.mode === 'taiko' ? 1 : c.keyMode === '7k' ? 7 : 4);
const laneColour = (lanes: number, i: number) =>
  lanes === 7 ? (i === 3 ? 'butter' : i % 2 === 0 ? 'sky' : 'pink') : (i === 0 || i === 3 ? 'sky' : 'pink');
---
<div class="cp" data-keys>
  {multi && (
    <div class="cp-head">
      <span class="label">Key mode</span>
      <KeySwitch options={items.map((it) => ({ id: it.chart.id, label: it.label ?? it.chart.id }))} label="osu!mania key mode" />
    </div>
  )}

  {items.map((it, k) => {
    const c = it.chart;
    const sources = audioSources(c.audio);
    const hasAudio = sources.length > 0;
    const lanes = lanesOf(c);
    const kind = c.mode === 'taiko' ? 'osu!taiko' : `osu!mania ${c.keyMode?.toUpperCase()}`;
    return (
      <div class:list={['player card', `p-${c.mode}`]} data-chart={c.id} data-keys-panel={c.id} hidden={k !== 0}>
        <div class="info">
          <p class="label">{kind}</p>
          <h3><span lang={/[^\x00-\x7F]/.test(c.artist) ? 'ja' : undefined}>{c.artist}</span> – {c.title}</h3>
          <div class="credits">
            <p>Music: <a href={c.songUrl ?? camelliaUrl} target="_blank" rel="noopener noreferrer">{c.artistLatin}</a> – {c.title}{c.album && <> (<i>{c.album}</i>)</>}</p>
            <p>Chart: {c.difficulty} by {c.mapper} · {c.stars}★ · {c.bpm} BPM · {mmss(c.lengthSec)}</p>
          </div>

          <div class="stats-head label">My ranking{c.keyMode && ` (${c.keyMode.toUpperCase()})`}</div>
          <div class="stats">
            {it.stats.map((s) => <div class="stat"><b><Ph value={s.value} hint={s.hint} /></b><small>{s.label}</small></div>)}
          </div>

          <div class="preview" role="group" aria-label={`Song preview: ${c.title}`}>
            <button class="pp" type="button" data-pp aria-pressed="false" disabled={!hasAudio}>
              <span class="i-play" aria-hidden="true">▶</span><span class="i-pause" aria-hidden="true">❚❚</span>
              <span class="sr-only">Play preview</span>
            </button>
            <input class="seek" type="range" min="0" max={c.lengthSec} step="0.1" value="0" data-seek
                   aria-label="Song position" disabled={!hasAudio} />
            <output class="time" data-time>0:00 / {mmss(c.lengthSec)}</output>
          </div>
          {hasAudio
            ? <audio preload="none" data-audio>{sources.map((s) => <source src={s.src} type={s.type} />)}</audio>
            : <p class="soon">Song coming soon. The slider will scrub through it.</p>}

          <div class="controls">
            <button class="btn" type="button" disabled title="Play mode coming soon">Play</button>
            <a class="btn" href={c.beatmapUrl} target="_blank" rel="noopener noreferrer">osu! link ↗</a>
          </div>
          {c.scrollSpeed && <p class="foot">Scroll speed: <b>{c.scrollSpeed}</b></p>}
        </div>

        <div class="stage" aria-hidden="true" data-scroll-ms={c.scrollSpeed ? maniaScrollTimeMs(c.scrollSpeed) : undefined}>
          {c.mode === 'taiko' ? (
            <div class="taiko">
              <div class="drum"><span></span></div>
              <div class="lane">
                <i class="n don" style="left:18%"></i><i class="n kat" style="left:30%"></i><i class="n don big" style="left:46%"></i>
                <i class="n kat" style="left:60%"></i><i class="n don" style="left:70%"></i><i class="n kat big" style="left:84%"></i>
              </div>
            </div>
          ) : (
            <div class:list={['mania', `k${lanes}`]} style={`--lanes:${lanes}`}>
              {Array.from({ length: lanes }, (_, i) => (
                <div class="col">
                  {[[10, 0], [34, 1], [58, 0], [78, 1]].filter((_, j) => (j + i) % 2 === 0).map(([top, hold]) =>
                    <i class:list={['note', hold && 'hold', `bg-${laneColour(lanes, i)}`]} style={`top:${(top! + i * 9) % 80}%`}></i>)}
                  <span class="key"></span>
                </div>
              ))}
            </div>
          )}
          <Vh name="vh-heart-target" class="badge" />
        </div>
      </div>
    );
  })}
</div>

<style>
  .cp{display:flex;flex-direction:column;gap:12px}
  .cp-head{display:flex;align-items:center;gap:10px}
  .player{display:grid;grid-template-columns:1fr 1fr;overflow:hidden}
  .player[hidden]{display:none}
  /* taiko: info hugs the left, the lane gets the room; mania: tall stage */
  .p-taiko{grid-template-columns:1fr}
  .p-taiko .stage{order:-1;aspect-ratio:6.8267/1;min-height:0;border-left:0;border-bottom:var(--stroke) solid var(--ink)} /* just the play lane, full width */
  @media (max-width:820px){ .p-taiko .stage{aspect-ratio:auto;height:150px} }
  .p-mania .stage{min-height:520px}
  .info{padding:20px;display:flex;flex-direction:column;gap:10px;min-width:0}
  h3{font-size:clamp(14px,1.6vw,22px);margin:0;white-space:nowrap}
  .credits p{margin:0;font-size:13px;color:var(--muted);font-weight:700}
  .credits a{color:var(--accent)}
  .stats-head{margin-top:2px}
  .stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(88px,1fr));gap:8px}
  .stat b{font-size:18px}

  .preview{display:flex;align-items:center;gap:10px;border:2px solid var(--ink);border-radius:99px;padding:4px 12px 4px 4px;background:var(--sunk)}
  .pp{flex:none;width:34px;height:34px;border-radius:50%;border:2px solid var(--ink);background:var(--butter);color:var(--on-pastel);
      display:grid;place-items:center;cursor:pointer;font-size:12px;line-height:1}
  .pp[disabled]{opacity:.45;cursor:not-allowed}
  .pp .i-pause{display:none}
  .pp[aria-pressed="true"] .i-play{display:none}
  .pp[aria-pressed="true"] .i-pause{display:inline}
  .seek{flex:1;min-width:0;accent-color:var(--accent);height:24px;cursor:pointer}
  .seek[disabled]{cursor:not-allowed;opacity:.5}
  .time{flex:none;font:700 12px var(--hud);min-width:9ch;text-align:right}
  .soon{margin:-4px 0 0;font-size:12px;color:var(--muted);font-weight:700}
  .controls{display:flex;flex-wrap:wrap;gap:10px}
  .foot{margin:0;font-size:13px;color:var(--muted);font-weight:700}
  kbd{font:700 12px var(--hud);border:2px solid var(--ink);border-radius:6px;padding:0 5px}

  .stage{position:relative;border-left:var(--stroke) solid var(--ink);background:var(--navy);min-height:300px;overflow:hidden}
  .stage :global(.badge){position:absolute;right:12px;top:12px;width:34px;color:var(--pink)}
  /* taiko */
  .taiko{position:absolute;inset:0;display:flex;align-items:center}
  .drum{flex:none;width:96px;height:96px;margin-left:16px;border-radius:50%;border:4px solid #fff8fc;background:#2a2944;display:grid;place-items:center;z-index:1}
  .drum span{width:56px;height:56px;border-radius:50%;border:3px dashed var(--pink)}
  .lane{position:relative;flex:1;height:88px;margin-left:-20px;background:#2a2944;border-block:3px solid #fff8fc}
  .n{position:absolute;top:50%;width:44px;height:44px;margin-top:-22px;border-radius:50%;border:3px solid #fff8fc}
  .n.big{width:60px;height:60px;margin-top:-30px}
  .don{background:var(--pink)} .kat{background:var(--sky)}
  /* mania */
  .mania{position:absolute;inset:0 18% 0;display:grid;grid-template-columns:repeat(var(--lanes),1fr);border-inline:3px solid #fff8fc}
  .mania.k7{inset:0 8% 0}
  .col{position:relative;border-left:1px solid #ffffff22}
  .note{position:absolute;left:8%;right:8%;height:16px;border-radius:6px;border:2px solid #1f1e33}
  .note.hold{height:64px}
  .key{position:absolute;left:6%;right:6%;bottom:12px;height:20px;border-radius:8px;border:3px solid #fff8fc;background:#2a2944}
  .k7 .note{height:12px;border-radius:4px} .k7 .note.hold{height:52px}
  @media (max-width:520px){ .stat b{font-size:14px} .stats{gap:6px} .time{min-width:0} }
  @media (max-width:820px){ .player{grid-template-columns:1fr} .p-mania .stage{min-height:420px} .p-mania .stage{border-left:0;border-top:var(--stroke) solid var(--ink)} }
</style>

<script>
  import '../scripts/chart-preview.ts';
  import '../scripts/chart-render.ts';
</script>
