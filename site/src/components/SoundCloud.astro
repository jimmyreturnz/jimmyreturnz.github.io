---
// SoundCloud playlist/track embed. Click-to-load: nothing from SoundCloud is fetched until the visitor asks,
// which keeps pages fast and avoids third-party cookies on first view.
// Volume can later be ducked under Feature audio via the SoundCloud Widget API (w.soundcloud.com/player/api.js).
// CSP: allow frame-src https://w.soundcloud.com (and script-src for api.js if the Widget API is used).
import Vh from './Vh.astro';
interface Props { url: string; title?: string }
const { url, title = 'My SoundCloud playlist' } = Astro.props;
const src = `https://w.soundcloud.com/player/?${new URLSearchParams({
  url, color: '#c23a7a', auto_play: 'false', hide_related: 'true', show_comments: 'false',
  show_user: 'true', show_reposts: 'false', show_teaser: 'false', visual: 'false',
})}`;
---
<div class="card sc" data-sc data-src={src}>
  <div class="ph-box">
    <Vh name="vh-eq" class="eq" />
    <div><b>{title}</b><small>Plays from SoundCloud. Loads only when you press the button.</small></div>
    <button class="btn fill" type="button" data-sc-load>Load player</button>
  </div>
</div>

<style>
  .sc{overflow:hidden}
  .ph-box{display:flex;align-items:center;gap:14px;padding:16px 18px;flex-wrap:wrap}
  .ph-box :global(.eq){width:44px;color:var(--pink)}
  .ph-box b{display:block;font:16px var(--display)} .ph-box small{color:var(--muted);font-weight:700}
  .ph-box button{margin-left:auto}
  .sc :global(iframe){display:block;width:100%;height:380px;border:0}
</style>

<script>
  document.addEventListener('astro:page-load', () => document.querySelectorAll<HTMLElement>('[data-sc]').forEach((box) => {
    box.querySelector('[data-sc-load]')?.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = box.dataset.src!;
      f.title = 'SoundCloud player';
      f.allow = 'autoplay';
      f.loading = 'lazy';
      box.replaceChildren(f);
    });
  }));
</script>
