---
// Brand + UI icons. Brand paths come from simple-icons (CC0). LinkedIn isn't in simple-icons,
// so it's a plain "in" badge; email is a hand-drawn envelope.
import { siGithub, siInstagram, siFacebook, siOsu, siDiscord } from 'simple-icons';

type Name = 'github' | 'linkedin' | 'instagram' | 'facebook' | 'email' | 'osu' | 'discord' | 'tetrio';
interface Props { name: Name; size?: number; class?: string }
const { name, size = 20, class: cls } = Astro.props;
const brand: Partial<Record<Name, string>> = {
  github: siGithub.path, instagram: siInstagram.path, facebook: siFacebook.path, osu: siOsu.path, discord: siDiscord.path,
};
const path = brand[name];
---
<svg class:list={['icon', cls]} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
  {path && <path d={path} />}
  {name === 'linkedin' && (
    <>
      <rect x="1.5" y="1.5" width="21" height="21" rx="4" />
      <path fill="var(--icon-cut, #fff)" d="M6 9.5h2.6V18H6zM7.3 5.4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3zM10.4 9.5h2.5v1.2c.4-.7 1.3-1.4 2.7-1.4 2.6 0 3.1 1.7 3.1 4V18h-2.6v-4.1c0-1 0-2.2-1.4-2.2s-1.6 1-1.6 2.1V18h-2.6z" />
    </>
  )}
  {name === 'email' && (
    <path fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" d="M3 5.5h18v13H3zM3.5 6l8.5 7 8.5-7" />
  )}
  {name === 'tetrio' && (
    <path d="M3 9h6V3h6v6h6v6h-6v6H9v-6H3z" />
  )}
</svg>
