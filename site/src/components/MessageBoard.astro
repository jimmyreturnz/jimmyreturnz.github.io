---
// The Message Board: a chat panel opened from the header's Chat button, on every Portfolio page.
// It shows only when the site is built with the API address (PUBLIC_API_URL) and a Turnstile site key.
const api = import.meta.env.PUBLIC_API_URL as string | undefined, sitekey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY as string | undefined;
---
{api && sitekey && (
  <>
    <button type="button" class="tg chatbtn" data-chat-btn aria-haspopup="dialog" aria-expanded="false" aria-controls="board" title="Message Board"><span class="ic" aria-hidden="true">💬</span><span>Chat</span></button>
    <dialog class="board" id="board" aria-label="Message Board">
      <div class="card chat" data-board data-api={api} data-sitekey={sitekey}>
        <header class="chat-top"><b><span aria-hidden="true">#</span> messages</b><small>Leave a message here</small><button type="button" class="chip x" data-chat-close aria-label="Close the Message Board">✕</button></header>
        <div class="feed" data-feed>
          <p class="state meta" role="status">Loading messages…</p>
          <ol class="list" aria-live="polite" aria-label="Messages"></ol>
        </div>
        <form class="compose">
          <div class="ts"></div>
          <p class="meta out" role="status" data-out></p>
          <div class="row">
            <input name="name" maxlength="40" autocomplete="nickname" required placeholder="Your name" aria-label="Your name" />
            <textarea name="message" maxlength="1000" rows="1" required placeholder="Message #messages" aria-label="Message"></textarea>
            <button class="send" type="submit" aria-label="Send">➤</button>
          </div>
          <small class="count" data-count></small>
        </form>
      </div>
    </dialog>
  </>
)}

<script>
  import { gsap } from 'gsap';
  import { reduced } from '../scripts/motion';
  import { sfx } from '../scripts/audio';
  type Msg = { id: number; name: string; body: string; link: string | null; created_at: number; edited_at: number | null };

  // edit keys for messages sent from this browser ({id: key}); the server only keeps their hashes
  const KEYS = 'jr.board.keys';
  const keys = (): Record<string, string> => { try { return JSON.parse(localStorage.getItem(KEYS) ?? '{}'); } catch { return {}; } };
  const saveKey = (id: number, key: string) => { try { localStorage.setItem(KEYS, JSON.stringify({ ...keys(), [id]: key })); } catch { /* private mode: no editing later */ } };
  type Turnstile = { render: (el: HTMLElement, o: object) => string; reset: (id: string) => void; remove: (id: string) => void };

  // Turnstile's script loads only once someone starts writing a message
  let tsScript: Promise<Turnstile> | null = null;
  const loadTurnstile = () => tsScript ??= new Promise((res, rej) => {
    const s = Object.assign(document.createElement('script'), { src: 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit', async: true });
    s.onload = () => res((window as unknown as { turnstile: Turnstile }).turnstile); s.onerror = rej; document.head.append(s);
  });

  // no profile pictures: each name gets a pastel circle with its first letter, the colour picked from the name
  const TINTS = ['pink', 'lav', 'mint', 'sky', 'butter'];
  const tintOf = (name: string) => TINTS[[...name].reduce((h, c) => (h * 31 + c.codePointAt(0)!) >>> 0, 7) % TINTS.length];
  const firstLetter = (name: string) => [...new Intl.Segmenter().segment(name)][0]?.segment.toUpperCase() ?? '?';

  // the panel lives in the persistent header: set it up once, fetch messages on the first open, refresh only while it's open
  document.addEventListener('astro:page-load', () => {
    const root = document.querySelector<HTMLElement>('[data-board]'), dlg = root?.closest('dialog'), opener = document.querySelector<HTMLButtonElement>('[data-chat-btn]');
    if (!root || !dlg || !opener || root.dataset.on) return;
    root.dataset.on = '1';
    let opened = false;
    // opening pops the panel in and blurs the page behind (.shown fades the backdrop in CSS); closing plays the same tween
    // backwards and fades the blur out, then closes the dialog. Closing mid-entry reverses from wherever it got to.
    let enter: gsap.core.Tween | null = null;
    opener.addEventListener('click', () => {
      sfx.swish(); dlg.showModal(); opener.setAttribute('aria-expanded', 'true');
      requestAnimationFrame(() => dlg.classList.add('shown'));
      if (!opened) { opened = true; void load(); } else { void sync(); feed.scrollTop = feed.scrollHeight; }
      enter?.kill(); gsap.set(dlg, { clearProps: 'all' });
      enter = reduced() ? null : gsap.fromTo(dlg, { y: 24, opacity: 0, scale: 0.97 }, { y: 0, opacity: 1, scale: 1, duration: 0.35, ease: 'back.out(1.4)' });
    });
    const hide = () => {
      if (!dlg.open || dlg.classList.contains('leaving')) return;
      dlg.classList.add('leaving'); dlg.classList.remove('shown');
      const done = () => { dlg.classList.remove('leaving'); dlg.close(); gsap.set(dlg, { clearProps: 'all' }); enter = null; };
      if (enter && enter.progress() > 0) enter.eventCallback('onReverseComplete', done).reverse(); else done();
    };
    dlg.querySelector('[data-chat-close]')!.addEventListener('click', hide);
    dlg.addEventListener('cancel', (e) => { e.preventDefault(); hide(); }); // Escape
    dlg.addEventListener('close', () => { dlg.classList.remove('shown', 'leaving'); opener.setAttribute('aria-expanded', 'false'); });
    dlg.addEventListener('click', (e) => { if (e.target === dlg) hide(); }); // a click on the backdrop closes it
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const api = root.dataset.api!, feed = q('[data-feed]'), list = q('ol'), state = q('.state');
    const form = q<HTMLFormElement>('form'), out = q('[data-out]'), count = q('[data-count]');
    const day = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }), time = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit' });
    const when = (t: number) => { const d = new Date(t); return d.toDateString() === new Date().toDateString() ? `Today at ${time.format(d)}` : day.format(d); };
    let page = 1, more = false, loading = false;

    const sig = (m: Msg) => `${m.name}|${m.body}|${m.link ?? ''}|${m.edited_at ?? ''}`;
    // names and messages go in with textContent only: always plain text, never HTML
    const item = (m: Msg) => {
      const li = document.createElement('li');
      const av = Object.assign(document.createElement('span'), { className: `av bg-${tintOf(m.name)}`, textContent: firstLetter(m.name) }); av.setAttribute('aria-hidden', 'true');
      const head = document.createElement('div'), name = document.createElement(m.link ? 'a' : 'b');
      name.textContent = m.name; name.className = 'who';
      if (m.link) Object.assign(name, { href: m.link, rel: 'nofollow noopener ugc', target: '_blank' });
      const t = Object.assign(document.createElement('time'), { textContent: when(m.created_at), dateTime: new Date(m.created_at).toISOString() });
      const edited = Object.assign(document.createElement('small'), { className: 'edited', textContent: m.edited_at ? '(edited)' : '' });
      head.append(name, t, edited);
      const p = Object.assign(document.createElement('p'), { textContent: m.body });
      const text = document.createElement('div'); text.append(head, p);
      const key = keys()[m.id];
      if (key) { // your own message: edit it in place (no cooldown)
        const eb = Object.assign(document.createElement('button'), { type: 'button', className: 'edit', textContent: 'Edit' });
        eb.addEventListener('click', () => {
          const ta = Object.assign(document.createElement('textarea'), { value: m.body, maxLength: 1000, rows: 2, className: 'editbox' });
          ta.setAttribute('aria-label', 'Edit your message');
          const err = Object.assign(document.createElement('small'), { className: 'edit-err' });
          const done = () => { ta.replaceWith(p); err.remove(); eb.hidden = false; };
          const save = async () => {
            if (ta.value.trim() === m.body) return done();
            const r = await fetch(`${api}/messages/${m.id}`, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ message: ta.value, key }) }).catch(() => null);
            const d = (await r?.json().catch(() => ({}))) as { body?: string; edited_at?: number; error?: string };
            if (!r?.ok) { err.textContent = d?.error ?? 'That didn’t save. Please try again.'; return; }
            m.body = d.body ?? ta.value.trim(); m.edited_at = d.edited_at ?? Date.now();
            p.textContent = m.body; edited.textContent = '(edited)'; done();
          };
          // Enter saves, Shift+Enter makes a new line, Escape cancels
          ta.addEventListener('keydown', (e) => { if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) { e.preventDefault(); void save(); } else if (e.key === 'Escape') done(); });
          p.replaceWith(ta); ta.after(err); eb.hidden = true;
          ta.style.height = `${Math.min(ta.scrollHeight, 200)}px`; ta.focus(); ta.setSelectionRange(ta.value.length, ta.value.length);
          err.textContent = 'Enter to save · Esc to cancel';
        });
        head.append(eb);
      }
      li.dataset.id = String(m.id); li.dataset.sig = sig(m); li.append(av, text); return li;
    };
    // newest at the bottom, like a chat; scrolling to the top loads older messages above without moving what you're reading
    const load = async () => {
      if (loading) return; loading = true;
      try {
        const r = await fetch(`${api}/messages?page=${page}`); if (!r.ok) throw 0;
        const d = (await r.json()) as { items: Msg[]; more: boolean };
        const first = page === 1, keep = feed.scrollHeight - feed.scrollTop;
        const lis = d.items.slice().reverse().map((m) => item(m));
        list.prepend(...lis); more = d.more; page++;
        if (first) { feed.scrollTop = feed.scrollHeight; if (lis.length) gsap.from(lis.slice(-6), { y: 14, opacity: 0, duration: 0.4, stagger: 0.05, ease: 'power2.out', clearProps: 'all' }); }
        else feed.scrollTop = feed.scrollHeight - keep;
        state.hidden = !!list.children.length; state.textContent = 'No messages yet. Be the first!';
      } catch { state.hidden = false; state.textContent = 'Messages couldn’t load right now.'; }
      loading = false;
    };
    feed.addEventListener('scroll', () => { if (more && feed.scrollTop < 80) void load(); }, { passive: true });

    // live: every 10 s while the tab is visible, fetch the newest page and merge it in: new messages appear at the bottom, edits and
    // profile links update in place (not while you're editing that one), and messages the owner deleted disappear
    // ponytail: polling; a WebSocket (Durable Object) only pays off if the board gets busy
    const sync = async () => {
      if (document.hidden || !dlg.open || loading || page === 1) return;
      const d = await fetch(`${api}/messages?page=1`).then((r) => (r.ok ? r.json() : null)).catch(() => null) as { items: Msg[]; more: boolean } | null;
      if (!d) return;
      const byId = new Map([...list.children].map((li) => [(li as HTMLElement).dataset.id!, li as HTMLElement]));
      const atBottom = feed.scrollHeight - feed.scrollTop - feed.clientHeight < 40, oldest = d.more ? d.items.at(-1)!.id : 0, added: HTMLElement[] = [];
      for (const m of d.items.slice().reverse()) {
        const li = byId.get(String(m.id));
        if (!li) { const n = item(m); list.append(n); added.push(n); }
        else if (li.dataset.sig !== sig(m) && !li.querySelector('.editbox')) li.replaceWith(item(m));
      }
      // missing from the newest page (or from the whole board when it all fits on one page): deleted by the owner
      const live = new Set(d.items.map((m) => String(m.id)));
      byId.forEach((li, id) => { if (Number(id) > oldest && !live.has(id)) li.remove(); });
      if (added.length) { if (atBottom) feed.scrollTop = feed.scrollHeight; gsap.from(added, { y: 14, opacity: 0, duration: 0.4, stagger: 0.05, ease: 'power2.out', clearProps: 'all' }); }
      state.hidden = !!list.children.length;
    };
    const timer = setInterval(() => void sync(), 10_000);
    const onVis = () => { if (!document.hidden) void sync(); };
    document.addEventListener('visibilitychange', onVis);
    // leaving the Portfolio (the Lobby has no header): the panel goes away, so stop its timers
    const leave = (e: Event) => {
      if ((e as Event & { newDocument: Document }).newDocument.querySelector('[data-board]')) return;
      clearInterval(timer); clearInterval(coolTimer); document.removeEventListener('visibilitychange', onVis); document.removeEventListener('astro:before-swap', leave);
      if (ts && wid) ts.remove(wid);
    };
    document.addEventListener('astro:before-swap', leave);

    let ts: Turnstile | null = null, wid = '', token = '';
    const ensureTs = async () => {
      if (wid) return;
      ts = await loadTurnstile().catch(() => null); if (!ts || wid) return;
      wid = ts.render(q('.ts'), { sitekey: root.dataset.sitekey, size: 'flexible', appearance: 'interaction-only', theme: document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light', callback: (t: string) => { token = t; }, 'expired-callback': () => { token = ''; } });
    };
    form.addEventListener('focusin', () => void ensureTs());
    const msg = form.elements.namedItem('message') as HTMLTextAreaElement;
    const grow = () => { msg.style.height = 'auto'; msg.style.height = `${Math.min(msg.scrollHeight, 140)}px`; };
    msg.addEventListener('input', () => { grow(); const n = [...msg.value].length; count.textContent = n > 800 ? `${n} / 1000` : ''; });
    // Enter sends, Shift+Enter makes a new line (not while typing Thai/Japanese with an input method)
    msg.addEventListener('keydown', (e) => { if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) { e.preventDefault(); form.requestSubmit(); } });

    // spam filter: 60 s between messages; the send button counts down
    const btn = q<HTMLButtonElement>('.send');
    let coolTimer = 0;
    const cooldown = (s: number) => {
      clearInterval(coolTimer); btn.disabled = true;
      const end = Date.now() + s * 1000;
      const tick = () => { const left = Math.ceil((end - Date.now()) / 1000); if (left > 0) { btn.textContent = String(left); btn.setAttribute('aria-label', `Send again in ${left} seconds`); } else { clearInterval(coolTimer); btn.textContent = '➤'; btn.setAttribute('aria-label', 'Send'); btn.disabled = false; } };
      tick(); coolTimer = window.setInterval(tick, 250);
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (btn.disabled) return;
      await ensureTs();
      if (!token) { out.textContent = 'One moment, the spam check is still running.'; return; }
      btn.disabled = true; out.textContent = '';
      const fd = new FormData(form), name = String(fd.get('name') ?? ''), body = String(fd.get('message') ?? '');
      try {
        const r = await fetch(`${api}/messages`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name, message: body, token }) });
        const d = (await r.json().catch(() => ({}))) as Partial<Msg> & { error?: string; key?: string; cooldown?: number; retryAfter?: number };
        if (r.ok && d.id) {
          // the message pops in at the bottom, as the server stored it; this browser keeps its edit key
          if (d.key) saveKey(d.id, d.key);
          const li = item({ id: d.id, name: d.name ?? name.trim(), body: d.body ?? body.trim(), link: null, created_at: d.created_at ?? Date.now(), edited_at: null });
          list.append(li); state.hidden = true; feed.scrollTop = feed.scrollHeight;
          gsap.from(li, { y: 18, opacity: 0, scale: 0.97, duration: 0.45, ease: 'back.out(1.6)', clearProps: 'transform' });
          msg.value = ''; grow(); count.textContent = '';
          cooldown(d.cooldown ?? 60);
        } else {
          out.textContent = d.error ?? 'That didn’t send. Please try again.';
          if (d.retryAfter) cooldown(d.retryAfter); else btn.disabled = false;
        }
      } catch { out.textContent = 'That didn’t send. Please try again.'; btn.disabled = false; }
      token = ''; if (ts && wid) ts.reset(wid);
    });

  });
</script>

<style>
  .chatbtn{margin-left:auto}
  .chatbtn .ic{font-size:15px;line-height:1}
  @media (max-width:820px){ .chatbtn span.ic{display:inline} } /* .tg hides its label spans on small screens; keep the icon */
  /* the panel: docked bottom-right on wide screens, nearly full screen on phones */
  .board{border:0;padding:0;background:none;width:min(440px,calc(100vw - 32px));max-width:none;max-height:none;margin:auto 16px 16px auto;overflow:visible;color:var(--ink)}
  .board::backdrop{background:transparent;backdrop-filter:blur(0);transition:background .35s ease,backdrop-filter .35s ease}
  .board.shown::backdrop{background:color-mix(in srgb,#1f1e33 35%,transparent);backdrop-filter:blur(2px)}
  .board.leaving{pointer-events:none} /* no clicks on a panel that's on its way out */
  .chat{display:flex;flex-direction:column;height:min(620px,calc(100dvh - 32px));padding:0;overflow:hidden}
  @media (max-width:560px){ .board{margin:auto auto 8px;width:calc(100vw - 16px)} .chat{height:calc(100dvh - 16px)} }
  .chat-top{display:flex;align-items:center;gap:10px;padding:10px 12px 10px 18px;border-bottom:2px solid color-mix(in srgb,var(--ink) 15%,transparent)}
  .chat-top small{color:var(--muted);font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .chat-top .x{margin-left:auto;width:36px;height:36px;padding:0;flex:none}
  .chat-top b{font:15px var(--display)} .chat-top b span{color:var(--accent)}
  .feed{position:relative;flex:1;overflow-y:auto;overscroll-behavior:contain}
  .list{list-style:none;margin:0;padding:8px 18px}
  /* list items are made by the script, so their styles are global (scoped styles only reach markup in this file) */
  .list :global(li){display:grid;grid-template-columns:38px 1fr;gap:12px;padding:10px 0}
  .list :global(.av){width:38px;height:38px;border-radius:50%;display:grid;place-items:center;font:700 16px var(--body),'Mali','M PLUS Rounded 1c',sans-serif;color:var(--on-pastel);border:2px solid var(--ink)}
  .list :global(li > div > div){display:flex;gap:10px;align-items:baseline;flex-wrap:wrap}
  .list :global(.who){font-weight:700;overflow-wrap:anywhere}
  .list :global(a.who){color:var(--accent)}
  .list :global(time),.list :global(.edited){font-size:12px;color:var(--muted)}
  .list :global(.edit){margin-left:auto;font:700 12px var(--body);color:var(--accent);background:none;border:0;padding:2px 4px;cursor:pointer;opacity:.75}
  .list :global(.edit:hover),.list :global(.edit:focus-visible){opacity:1;text-decoration:underline}
  .list :global(.editbox){display:block;width:100%;margin-top:4px;font:inherit;font-family:var(--body),'Mali','M PLUS Rounded 1c',sans-serif;border:2px solid var(--ink);border-radius:10px;padding:6px 8px;background:var(--sunk);color:var(--ink);resize:vertical}
  .list :global(.edit-err){display:block;font-size:12px;color:var(--muted);margin-top:2px}
  .list :global(p){margin:2px 0 0;white-space:pre-line;overflow-wrap:anywhere;font-family:var(--body),'Mali','M PLUS Rounded 1c',sans-serif}
  .state{position:absolute;inset:0;display:grid;place-items:center;margin:0;text-align:center;padding:16px}
  .state[hidden]{display:none}
  .compose{padding:10px 14px 12px;border-top:2px solid color-mix(in srgb,var(--ink) 15%,transparent);display:flex;flex-direction:column;gap:6px}
  .compose .row{display:flex;gap:8px;align-items:flex-end;background:var(--sunk);border:2px solid var(--ink);border-radius:14px;padding:6px}
  .compose input,.compose textarea{font:inherit;font-family:var(--body),'Mali','M PLUS Rounded 1c',sans-serif;border:0;background:transparent;color:var(--ink);padding:6px 8px}
  .compose input{width:9.5em;flex:none;border-right:2px dashed color-mix(in srgb,var(--ink) 25%,transparent);border-radius:0}
  .compose textarea{flex:1;resize:none;min-height:36px;line-height:1.5}
  .compose input:focus-visible,.compose textarea:focus-visible{outline:none}
  .compose .row:focus-within{box-shadow:0 0 0 3px color-mix(in srgb,var(--accent) 45%,transparent)}
  .send{flex:none;width:38px;height:38px;padding:0;display:grid;place-items:center;border-radius:50%;border:2px solid var(--ink);background:var(--pink);color:var(--on-pastel);cursor:pointer;font:700 15px/1 var(--hud);font-variant-numeric:tabular-nums}
  .send[disabled]{font-size:12px} /* the cooldown seconds */
  .send[disabled]{opacity:.6}
  .count{align-self:flex-end;color:var(--muted);font-size:12px}
  .count:empty,.out:empty,.ts:empty{display:none}
  .out{margin:0}
  @media (max-width:560px){ .compose .row{flex-wrap:wrap} .compose input{width:100%;border-right:0;border-bottom:2px dashed color-mix(in srgb,var(--ink) 25%,transparent)} }
</style>
