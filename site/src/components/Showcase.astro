---
import Vh from './Vh.astro';
interface Props { id: string; title: string; lead?: string; motif?: string; tint?: 'pink' | 'mint' | 'sky' | 'lav' | 'butter' }
const { id, title, lead, motif = 'vh-chevrons', tint = 'pink' } = Astro.props;
---
<section class="show" id={id} aria-labelledby={`${id}-h`} style={`--tint:var(--${tint})`}>
  <div class="head">
    <h2 id={`${id}-h`}>{title} <Vh name={motif} class="m" /></h2>
    {lead && <p>{lead}</p>}
  </div>
  <slot />
</section>

<style>
  .show{padding:48px 0 40px;border-top:3px dashed var(--dash)}
  .show:first-of-type{border-top:0;padding-top:24px}
  .head{display:flex;flex-wrap:wrap;align-items:flex-end;gap:8px 18px;margin-bottom:20px}
  h2{font-size:clamp(26px,4vw,40px);margin:0;display:flex;align-items:center;gap:12px}
  h2 :global(.m){height:.8em;width:auto;max-width:clamp(60px,8vw,100px);color:var(--tint)}
  p{margin:0;color:var(--muted);font-weight:700;max-width:56ch}
</style>
