---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Warp from '../components/Warp.astro';
import { bgm, profile } from '../data/site';
import { stats } from '../lib/stats';
import sprite from '../../../assets/vectorheart/vectorheart.svg?raw';

interface Props { title: string; description?: string; jp?: boolean /* page shows Japanese text: load the JP font */; noindex?: boolean /* private page: keep out of search */ }
const { jp = false, noindex = false, title, description ='Apiwat Kongsawat (Jimmy, jimmyreturnz) is a Data Scientist & Developer in Bangkok, a data science intern at BMW Group, and an osu!taiko, osu!mania and TETR.IO player.' } = Astro.props;
// Absolute URLs need the deployed address: set SITE_URL at build time (astro.config.mjs). Without it, these tags are left out.
const site = Astro.site;
const canonical = site && new URL(Astro.url.pathname, site).href;
const ogImage = site ? new URL('/og.png', site).href : '/og.png';
const person = {
  '@context': 'https://schema.org', '@type': 'Person',
  name: profile.fullName, alternateName: [profile.handle, profile.nickname],
  jobTitle: profile.role, ...(site && { url: site.href }),
  address: { '@type': 'PostalAddress', addressLocality: 'Bangkok', addressCountry: 'TH' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Mahidol University' },
  knowsLanguage: ['th', 'en', 'ja'],
  sameAs: [profile.links.github, profile.links.linkedin, profile.links.instagram, profile.links.facebook,
    stats.osu.profileUrl, stats.tetrio.profileUrl].filter(Boolean),
};
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <script is:inline>
      // decide before the first paint whether the Intro covers the Lobby (so nothing of the Lobby flashes first)
      try { if (location.pathname === '/' && (location.search.includes('intro=1') || localStorage.getItem('jr.intro') !== 'done')) document.documentElement.dataset.intro = 'on'; } catch (e) { if (location.pathname === '/') document.documentElement.dataset.intro = 'on'; }
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#fff8fc" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <link rel="icon" type="image/jpeg" href="/stats/osu-avatar.jpg" />
    <link rel="preload" href="/fonts/zen-dots/zen-dots-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/fonts/fonts.css" />
    <!-- Japanese glyphs: a big @font-face list (~60 KB), only on pages with Japanese text, without blocking the first paint -->
    {jp && <link rel="stylesheet" href="/fonts/fonts-jp.css" media="print" onload="this.media='all'" />}
    <!-- apply saved theme before first paint to avoid a flash -->
    <script is:inline>
      try {
        const r = document.documentElement;
        if (localStorage.getItem('jr.theme') === 'dark') r.dataset.theme = 'dark';
        if (localStorage.getItem('jr.motion') === 'full' || location.search.includes('motion=full')) r.dataset.motion = 'full';
      } catch {}
    </script>
    <!-- client-side page changes: pages animate into each other and the header/BGM persists -->
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <div hidden set:html={sprite} />
    <div hidden data-bgm-cfg data-src={bgm.file} data-lufs={bgm.lufs} data-name={`${bgm.artist} - ${bgm.title}`}></div>
    <slot />
    <Warp />
    <script>
      import '../scripts/motion.ts';
      import '../scripts/settings.ts';
      import '../scripts/fx.ts';
      import '../scripts/bgm.ts';
      import '../scripts/tilt.ts';
    </script>
  </body>
</html>
