---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import sprite from '../../../assets/vectorheart/vectorheart.svg?raw';

interface Props { title: string; description?: string }
const { title, description = 'Jimmy (Apiwat Kongsawat): Data Scientist & Developer, and osu!taiko, osu!mania and TETR.IO player.' } = Astro.props;
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fff8fc" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 92'%3E%3Cpath d='M50 86C22 66 6 50 6 30 6 16 17 6 30 6c9 0 16 5 20 12 4-7 11-12 20-12 13 0 24 10 24 24 0 20-16 36-44 56z' fill='%23ffb3d1' stroke='%231f1e33' stroke-width='6'/%3E%3C/svg%3E" />
    <link rel="preload" href="/fonts/zen-dots/zen-dots-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/fonts/fonts.css" />
    <link rel="stylesheet" href="/fonts/fonts-jp.css" />
    <!-- apply saved theme before first paint to avoid a flash -->
    <script is:inline>
      try {
        const r = document.documentElement;
        if (localStorage.getItem('jr.theme') === 'dark') r.dataset.theme = 'dark';
      } catch {}
    </script>
    <!-- client-side page changes: pages animate into each other and the header/BGM persists -->
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <div hidden set:html={sprite} />
    <slot />
    <script>
      import '../scripts/settings.ts';
    </script>
  </body>
</html>
