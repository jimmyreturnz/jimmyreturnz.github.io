---
// One Portfolio page: persistent header (BGM + settings), page body, footer.
import Base from './Base.astro';
import PortfolioHeader from '../components/PortfolioHeader.astro';
import Footer from '../components/Footer.astro';
import Sky from '../components/Sky.astro';
interface Props { title: string; description?: string; jp?: boolean; noindex?: boolean }
const { title, description, jp, noindex } = Astro.props;
---
<Base title={`${title} · jimmyreturnz`} description={description} jp={jp} noindex={noindex}>
  <Sky fixed />
  <div class="shell">
    <PortfolioHeader />
    <main class="wrap page" transition:animate="fade">
      <slot />
    </main>
    <Footer />
  </div>
</Base>

<style>
  /* short pages: the footer sits at the bottom of the screen instead of under a gap */
  .shell{position:relative;z-index:1;min-height:100vh;min-height:100dvh;display:flex;flex-direction:column}
  .shell > main{flex:1;width:100%}
</style>
